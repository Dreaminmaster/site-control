{
  "name": "site-control-fixture",
  "main": "fixture/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SITE_ID": "test-site"
  },
  "d1_databases": [
    {
      "binding": "FIXTURE_DB",
      "database_name": "site-control-fixture",
      "migrations_dir": "fixture/migrations"
    }
  ]
}
